generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  password    String
  full_name   String
  student_id  String
  class       String
  major       String
  avatar      String?  @db.Text
  github_url  String?
  figma_url   String?
  postman_url String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  actions Action[]

  @@map("user")
}

model Devices {
  id          Int      @id @default(autoincrement())
  name        String   // "LED", "FAN"
  type        String   // "LIGHT", "FAN"
  status      String   @default("OFF") // "ON", "OFF", "LOADING", "DISCONNECT"
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  actions Action[]

  @@map("Devices")
}

model Sensors {
  id          Int      @id @default(autoincrement())
  name        String   // "AHT20", "BH1750"
  type        String   // "TEMPERATURE", "HUMIDITY", "LIGHT"
  unit        String   // "°C", "%", "lux"
  status      String   @default("ACTIVE") // "ACTIVE", "INACTIVE", "DISCONNECT"
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  data_records DataSensor[]

  @@index([name])
  @@index([type])
  @@map("Sensors")
}

model DataSensor {
  id          Int      @id @default(autoincrement())
  sensor_id   Int
  value       Float
  recorded_at DateTime @default(now())

  sensor Sensors @relation(fields: [sensor_id], references: [id], onDelete: Cascade)

  @@index([sensor_id])
  @@index([recorded_at])
  @@map("Data sensor")
}

model Action {
  id              Int       @id @default(autoincrement())
  user_id         Int
  device_id       Int
  action          String    // "ON", "OFF"
  status          String    // "ON", "OFF", "LOADING", "DISCONNECT"
  activation_time DateTime  @default(now())
  response_time   Int?      // Response duration in milliseconds
  response_at     DateTime?
  created_at      DateTime  @default(now())

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device Devices @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([device_id])
  @@index([action])
  @@index([status])
  @@index([activation_time])
  @@map("Action")
}
